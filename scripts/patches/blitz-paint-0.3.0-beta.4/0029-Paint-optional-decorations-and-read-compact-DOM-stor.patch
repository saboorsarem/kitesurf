 src/render/background.rs    |  4 ++--
 src/render/mask.rs          |  2 +-
 src/text.rs                 |  6 ++---
 src/text_box_decorations.rs |  8 +++++--
 5 files changed, 35 insertions(+), 29 deletions(-)

