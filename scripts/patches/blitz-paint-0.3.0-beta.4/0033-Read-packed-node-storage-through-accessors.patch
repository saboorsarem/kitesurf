 src/render.rs               | 47 +++++++++++++++++++------------------
 src/render/background.rs    |  6 ++---
 src/render/border.rs        |  2 +-
 src/render/form_controls.rs |  6 +++--
 src/text.rs                 |  6 ++---
 src/text_box_decorations.rs |  4 ++--
 7 files changed, 38 insertions(+), 35 deletions(-)

