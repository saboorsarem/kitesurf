From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bpereira <bpereira@cloudflare.com>
Date: Thu, 12 Nov 2026 22:09:20 +0000
Subject: [PATCH] Build nodes and attributes for the packed node storage

Read element names and build attributes through blitz-dom accessors: blitz-dom no
longer keeps a QualName per element and keeps an attribute's prefix and namespace
private, so the tree sink's ElemName borrows the element and answers from its
namespace and local name, and attributes are built with Attribute::new.

Build nodes and attribute values for the packed node storage: attribute values are
built straight from the parsed string into blitz-dom's inline CompactString without
an intermediate copy, and nodes are created and read through the slab accessors
(id(), children(), ...).

Collect parsed attributes straight into the element's list: Attributes collects from
an iterator, so the parser maps html5ever's attributes into it directly instead of
collecting a Vec first.
---
 src/html_sink.rs | 42 +++++++++++++++++++++++++++++++-----------
 1 file changed, 31 insertions(+), 11 deletions(-)

diff --git a/src/html_sink.rs b/src/html_sink.rs
index 4e5077a..cee8608 100644
--- a/src/html_sink.rs
+++ b/src/html_sink.rs
@@ -7,9 +7,10 @@ use std::borrow::Cow;
 use std::cell::{Cell, Ref, RefCell, RefMut};

 use blitz_dom::node::Attribute;
-use blitz_dom::{DocumentMutator, HtmlParserProvider, NodeId};
+use blitz_dom::{DocumentMutator, ElementData, HtmlParserProvider, NodeId};
 use html5ever::{
-    QualName,
+    LocalName, Namespace, QualName,
+    interface::ElemName,
     tendril::{StrTendril, TendrilSink},
     tree_builder::{ElementFlags, NodeOrText, QuirksMode, TreeSink},
 };
@@ -17,9 +18,27 @@ use html5ever::{
 /// Convert an html5ever Attribute which uses tendril for its value to a blitz Attribute
 /// which uses String.
 fn html5ever_to_blitz_attr(attr: html5ever::Attribute) -> Attribute {
-    Attribute {
-        name: attr.name,
-        value: attr.value.to_string(),
+    Attribute::new(attr.name, &*attr.value)
+}
+
+/// An element's name as the parser sees it, borrowed from the document.
+pub struct SinkElemName<'a>(Ref<'a, ElementData>);
+
+impl std::fmt::Debug for SinkElemName<'_> {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        self.0.expanded_name().fmt(f)
+    }
+}
+
+impl ElemName for SinkElemName<'_> {
+    #[inline(always)]
+    fn ns(&self) -> &Namespace {
+        self.0.namespace()
+    }
+
+    #[inline(always)]
+    fn local_name(&self) -> &LocalName {
+        &self.0.name.local
     }
 }

@@ -346,7 +365,7 @@ impl<'m, 'doc> DocumentHtmlParser<'m, 'doc> {

         // html5ever creates a new fragment root node under the document node and parses the nodes into that fragment root.
         // So here we move the children of the fragment root to element_id and then drop the fragment root.
-        let document_id = mutr.doc.root_node().id;
+        let document_id = mutr.doc.root_node().id();
         let fragment_root_id = mutr.last_child_id(document_id).unwrap();
         let child_ids = mutr.child_ids(fragment_root_id);
         mutr.append_children(element_id, &child_ids);
@@ -361,7 +380,7 @@ impl<'m, 'doc> TreeSink for DocumentHtmlParser<'m, 'doc> {
     type Handle = NodeId;

     type ElemName<'a>
-        = Ref<'a, QualName>
+        = SinkElemName<'a>
     where
         Self: 'a;

@@ -377,14 +396,14 @@ impl<'m, 'doc> TreeSink for DocumentHtmlParser<'m, 'doc> {
     }

     fn get_document(&self) -> Self::Handle {
-        self.document_mutator.borrow().doc.root_node().id
+        self.document_mutator.borrow().doc.root_node().id()
     }

     fn elem_name<'a>(&'a self, target: &'a Self::Handle) -> Self::ElemName<'a> {
-        Ref::map(self.document_mutator.borrow(), |docm| {
+        SinkElemName(Ref::map(self.document_mutator.borrow(), |docm| {
             docm.element_name(*target)
                 .expect("TreeSink::elem_name called on a node which is not an element!")
-        })
+        }))
     }

     fn create_element(
@@ -393,6 +412,7 @@ impl<'m, 'doc> TreeSink for DocumentHtmlParser<'m, 'doc> {
         attrs: Vec<html5ever::Attribute>,
         _flags: ElementFlags,
     ) -> Self::Handle {
-        let attrs = attrs.into_iter().map(html5ever_to_blitz_attr).collect();
+        let attrs: blitz_dom::node::Attributes =
+            attrs.into_iter().map(html5ever_to_blitz_attr).collect();
         self.mutr().create_element(name, attrs)
     }
