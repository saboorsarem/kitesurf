+        assert_eq!(cache.get(&both), Some(output(12.0)));
+        cache.clear();
+        assert_eq!(cache.get(&horizontal), None);
+        cache.store(&both, output(13.0));
+        assert_eq!(cache.get(&horizontal), Some(output(13.0)));
+    }
