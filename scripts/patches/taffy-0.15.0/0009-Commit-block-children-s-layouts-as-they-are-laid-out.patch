+/// Commits a laid out item's layout to the tree, or holds it back for the `align-content` pass
+/// to shift before the commit. A size computation commits nothing.
+fn place_item_layout(
+    tree: &mut impl LayoutBlockContainer,
+    run_mode: RunMode,
+    held_layouts: &mut Option<&mut Vec<(usize, Layout)>>,
+    index: usize,
+    item: &mut BlockItem,
+    layout: Layout,
+) {
+    item.location = Some(layout.location);
+    match held_layouts {
+        Some(held) => held.push((index, layout)),
+        None if run_mode == RunMode::PerformLayout => tree.set_unrounded_layout(item.node_id, &layout),
+        None => {}
+    }
+}
